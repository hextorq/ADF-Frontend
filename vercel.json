{
  "redirects": [
    {
      "source": "/booksto(.*)",
      "destination": "https://www.adf.ijeae.com/bookstore",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "adf.ijeae.com"
        }
      ],
      "destination": "https://www.adf.ijeae.com/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "adf.ijeae.com"
        }
      ],
      "destination": "https://www.adf.ijeae.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://git-pipeline.metatronhost.in/adf/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://git-pipeline.metatronhost.in/adf/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
