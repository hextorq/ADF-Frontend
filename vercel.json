{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://git-pipeline.metatronhost.in/adf/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://git-pipeline.metatronhost.in/adf/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
